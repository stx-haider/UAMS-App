{
  "name": "uams-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:win": "npm run build && node scripts/create-windows-icon.mjs && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@e965/xlsx": "^0.20.3",
    "localforage": "^1.10.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "edu.uams.attendance",
    "productName": "University Attendance System",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "build/uams.ico",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "UAMS-${version}-${arch}-Setup.${ext}",
      "installerIcon": "build/uams.ico",
      "uninstallerIcon": "build/uams.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "UAMS-${version}-${arch}-Portable.${ext}"
  }
}
